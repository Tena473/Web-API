# Backend: generate a different 32-byte value for every environment.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:7000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=angkham-final
PORT=3000

# Frontend: only expose the API base URL, never AUTH_SESSION_SECRET or database values.
# Keep blank in the combined production service so the browser uses its current
# origin. Vite proxies /api to http://localhost:3000 during local development.
VITE_API_BASE_URL=

# Backend-only Google Calendar configuration. Do not prefix these with VITE_.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIME_ZONE=Asia/Vientiane
LAOS_HOLIDAY_CALENDAR_ID=en.la#holiday@group.v.calendar.google.com
US_HOLIDAY_CALENDAR_ID=en.usa#holiday@group.v.calendar.google.com
